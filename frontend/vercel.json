{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vue",
  "rewrites": [
    { 
      "source": "/api/(.*)", 
      "destination": "https://your-app.up.railway.app/api/$1" 
    },
    { 
      "source": "/((?!api/).*)", 
      "destination": "/index.html" 
    }
  ]
}
