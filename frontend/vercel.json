{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vue",
  "rewrites": [
    { 
      "source": "/api/:path*", 
      "destination": "https://pm-workbench-production-9356.up.railway.app/api/:path*" 
    },
    { 
      "source": "/((?!api/).*)", 
      "destination": "/index.html" 
    }
  ]
}
